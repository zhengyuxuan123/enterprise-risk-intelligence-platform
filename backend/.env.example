DB_HOST=localhost
DB_PORT=3306
DB_NAME=risk_platform
DB_USER=root
DB_PASSWORD=123456
JWT_SECRET=RiskPlatformSecretKeyForJwt2026ChangeMePlease123456789

# Optional capabilities. The platform is runnable with all three set to false.
APP_REDIS_ENABLED=false
APP_MQ_ENABLED=false
APP_AI_ENABLED=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# OpenAI-compatible endpoint, only used when APP_AI_ENABLED=true
# Pick ONE provider block below and fill AI_API_KEY.
#
# (A) OpenAI
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
#
# (B) Aliyun Bailian / DashScope  (key: https://bailian.console.aliyun.com -> API Key)
#     Beijing  : https://dashscope.aliyuncs.com/compatible-mode/v1   (Singapore: dashscope-intl.aliyuncs.com)
#AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#AI_MODEL=qwen-plus
#AI_EMBEDDING_MODEL=text-embedding-v3
#
# (C) Volcengine Ark / 火山方舟  (key: https://ark.volcengine.com/region:cn-beijing/apikey)
#     Docs: https://www.volcengine.com/docs/82379/2687970
#     AI_MODEL: use the endpoint id (ep-...) or the model id, e.g. deepseek-v4-1-flash-260910
#     NOTE: app.web-search below uses DashScope's native search_options and does NOT work on Ark,
#           and the DashScope embedding model above does NOT work on Ark. See the migration doc.
#AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#AI_MODEL=deepseek-v4-1-flash-260910
#AI_EMBEDDING_MODEL=<your-ark-embedding-model-or-ep-id>
#APP_RAG_EMBEDDING_ENABLED=false
#APP_WEB_SEARCH_ENABLED=false
#
# ---- Web search over MCP (recommended) --------------------------------------
# The platform speaks Model Context Protocol, so any MCP search server works
# (Brave / Tavily / Exa / your own gateway). Two transports:
#
# (A) stdio: the platform starts the server as a child process.
#     Give the command line only -- the server keeps its own credentials.
#     Example (npx, needs Node on PATH and BRAVE_API_KEY in the environment):
#APP_WEB_SEARCH_MCP_COMMAND=npx -y @modelcontextprotocol/server-brave-search
#
# (B) http: the platform POSTs JSON-RPC to a remote endpoint.
#APP_WEB_SEARCH_MCP_URL=https://your-mcp-gateway.example.com/mcp
#APP_WEB_SEARCH_MCP_HEADERS=Authorization: Bearer <token>
#
# Optional: pin the tool name instead of auto-probing tools/list, and override
# the call arguments template ({q} = query, {n} = result count). The defaults
# are only applied when these stay empty -- braces are awkward to escape in YAML.
#APP_WEB_SEARCH_MCP_TOOL_NAME=web_search
#APP_WEB_SEARCH_MCP_ARGS_TEMPLATE={"query":"{q}","max_results":{n}}
#
# Channel preference: auto = MCP -> direct crawl -> Ark API, first one that works.
#APP_WEB_SEARCH_MODE=auto
# Whether an analysis that never mentions external comparison may still be
# offered the web tool as a standby: signal (default) / always / never.
#APP_WEB_SEARCH_ALWAYS_OFFER=signal
