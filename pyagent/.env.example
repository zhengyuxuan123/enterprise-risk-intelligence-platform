# ============================================================================
# Python Agent 服务 —— 环境变量
# ============================================================================
# 关键约定：**所有键名与 Java 版完全一致**，所以你可以直接把 backend/.env
# 复制过来用，也可以两个服务共用同一份。这样双跑对照时不会出现
# "差异其实是配置不同"这种查不出来的问题。
# ----------------------------------------------------------------------------

# ---- 本服务自身（Java 没有这两项）----
# 故意与 Java 的 8080 错开，便于并存与双跑对照。
PY_AGENT_PORT=8081
PY_AGENT_HOST=127.0.0.1
PY_AGENT_LOG_LEVEL=INFO

# ---- 数据库（阶段 5 取数工具会用到，键名同 Java）----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=risk_platform
DB_USER=root
DB_PASSWORD=123456

# ---- 模型底座 ----
# 留空 AI_MODEL = 运行时自动从账号可用模型里选一个（推荐）。
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=
AI_MODEL=
AI_MODEL_CANDIDATES=
# disabled（默认）/ enabled / 留空 = 不下发该字段
APP_AI_THINKING_TYPE=disabled

# ---- 联网检索（三通道：MCP → 免 Key 直连 → 方舟 API）----
APP_WEB_SEARCH_ENABLED=true
APP_WEB_SEARCH_MODE=auto
# signal（默认）/ always / never —— 见 AgentRouter 的候补开放策略
APP_WEB_SEARCH_ALWAYS_OFFER=signal

# MCP 是首选通道：填上 command 或 url 即生效（enabled 默认为 true，
# 但真正的开关是"有没有配 command/url"，没配就自动跳过去走直连）。
#APP_WEB_SEARCH_MCP_COMMAND=npx -y @modelcontextprotocol/server-brave-search
#APP_WEB_SEARCH_MCP_URL=https://your-mcp-gateway.example.com/mcp
#APP_WEB_SEARCH_MCP_HEADERS=Authorization: Bearer <token>
#APP_WEB_SEARCH_MCP_TOOL_NAME=web_search
#APP_WEB_SEARCH_MCP_ARGS_TEMPLATE={"query":"{q}","count":{n}}

# ---- 检索（RAG）----
# local（默认，零成本、不联网、不需要 Key）/ remote / auto
APP_RAG_EMBEDDING_MODE=local
APP_RAG_LOCAL_EMBEDDING_DIM=512

# ---- Agent 行为 ----
APP_AGENT_DEFAULT_DEPTH=standard
# 提速第一杠杆：本地毫秒级预取，省掉"模型决定调什么工具"那一整轮往返
APP_AGENT_PREFETCH_TOOLS=true
APP_AGENT_SSE_TIMEOUT=900

# ---- 评估回归 ----
# 默认复用 Java 版的同一份用例文件，保证两边跑的是同一套题
APP_EVAL_CASES_FILE=../backend/src/main/resources/ai-eval-cases.json
APP_EVAL_GATE_SCORE=70
